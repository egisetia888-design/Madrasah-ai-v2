# ==============================================================================
# MADRASAH PKOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin berkas ini menjadi .env (atau masukkan di Settings > Environment Variables pada Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Penyedia AI Sisi Server (Vercel Serverless / Node Server)
# ------------------------------------------------------------------------------
# Google Gemini API (Primer)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatif: OpenRouter (Sekunder jika Gemini tidak dikonfigurasi)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Alternatif: HCNSEC / Custom OpenAI-compatible Provider
HCNSEC_API_KEY=
HCNSEC_BASE_URL=
HCNSEC_MODEL=

# URL Aplikasi (digunakan untuk header referer OpenRouter dan audit)
APP_URL=https://your-madrasah.vercel.app

# ------------------------------------------------------------------------------
# 2. Konfigurasi Firebase Klien (Opsional - Dual Sync Cloud)
# Jika tidak diisi, Madrasah beroperasi penuh secara luring menggunakan IndexedDB.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
